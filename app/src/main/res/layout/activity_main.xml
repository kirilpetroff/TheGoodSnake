<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical"
    android:padding="12dp"
    tools:context=".MainActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="casual"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:rotation="-3"
            android:shadowColor="@color/title_shadow"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="1"
            android:text="@string/app_name"
            android:textColor="@color/title_text"
            android:textSize="40sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_button_description"
            android:includeFontPadding="false"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/settings_symbol"
            android:textAllCaps="false"
            android:textColor="@color/pause_gray"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pauseButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/pause_button_description"
            android:includeFontPadding="false"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/pause_symbol"
            android:textAllCaps="false"
            android:textColor="@color/pause_gray"
            android:textSize="28sp"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- Игрово поле (голямото поле) - квадратно, с мрежа 40x40 клетки -->
    <com.example.sammysnake.SquareFrameLayout
        android:id="@+id/gameArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:layout_marginBottom="12dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_game_area"
        android:padding="8dp">

        <com.example.sammysnake.GameGridView
            android:id="@+id/gameGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/deathFlashOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/death_flash"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/gameOverText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_game_over"
            android:fontFamily="casual"
            android:paddingHorizontal="28dp"
            android:paddingVertical="14dp"
            android:text="@string/game_over_text"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </com.example.sammysnake.SquareFrameLayout>

    <!-- Точки и животи -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/scoreText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="casual"
            android:gravity="start"
            android:textColor="@color/title_text"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Точки: 0" />

        <TextView
            android:id="@+id/livesText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="casual"
            android:gravity="end"
            android:textColor="@color/food"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="❤❤❤" />

    </LinearLayout>

    <!-- Поле за управление (малкото поле с 4-те бутона) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controlsArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.4"
        android:background="@drawable/bg_controls_area">

        <!-- Невидима точка в центъра, около която подреждаме 4-те бутона -->
        <View
            android:id="@+id/dpadCenter"
            android:layout_width="1dp"
            android:layout_height="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btnUp"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_btn_up"
            app:backgroundTint="@null"
            android:contentDescription="@string/direction_up"
            android:includeFontPadding="false"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/arrow_up"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="26sp"
            app:layout_constraintCircle="@id/dpadCenter"
            app:layout_constraintCircleAngle="0"
            app:layout_constraintCircleRadius="60dp" />

        <Button
            android:id="@+id/btnRight"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_btn_right"
            app:backgroundTint="@null"
            android:contentDescription="@string/direction_right"
            android:includeFontPadding="false"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/arrow_right"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="26sp"
            app:layout_constraintCircle="@id/dpadCenter"
            app:layout_constraintCircleAngle="90"
            app:layout_constraintCircleRadius="60dp" />

        <Button
            android:id="@+id/btnDown"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_btn_down"
            app:backgroundTint="@null"
            android:contentDescription="@string/direction_down"
            android:includeFontPadding="false"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/arrow_down"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="26sp"
            app:layout_constraintCircle="@id/dpadCenter"
            app:layout_constraintCircleAngle="180"
            app:layout_constraintCircleRadius="60dp" />

        <Button
            android:id="@+id/btnLeft"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_btn_left"
            app:backgroundTint="@null"
            android:contentDescription="@string/direction_left"
            android:includeFontPadding="false"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/arrow_left"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="26sp"
            app:layout_constraintCircle="@id/dpadCenter"
            app:layout_constraintCircleAngle="270"
            app:layout_constraintCircleRadius="60dp" />

        <!-- Подсказки за посоките на плъзгане - показват се вместо бутоните в режим "Плъзгане" -->
        <TextView
            android:id="@+id/swipeHintUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:text="@string/arrow_up"
            android:textColor="@color/white"
            android:textSize="34sp"
            android:visibility="gone"
            app:layout_constraintCircle="@id/dpadCenter"
            app:layout_constraintCircleAngle="0"
            app:layout_constraintCircleRadius="60dp" />

        <TextView
            android:id="@+id/swipeHintRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:text="@string/arrow_right"
            android:textColor="@color/white"
            android:textSize="34sp"
            android:visibility="gone"
            app:layout_constraintCircle="@id/dpadCenter"
            app:layout_constraintCircleAngle="90"
            app:layout_constraintCircleRadius="60dp" />

        <TextView
            android:id="@+id/swipeHintDown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:text="@string/arrow_down"
            android:textColor="@color/white"
            android:textSize="34sp"
            android:visibility="gone"
            app:layout_constraintCircle="@id/dpadCenter"
            app:layout_constraintCircleAngle="180"
            app:layout_constraintCircleRadius="60dp" />

        <TextView
            android:id="@+id/swipeHintLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:text="@string/arrow_left"
            android:textColor="@color/white"
            android:textSize="34sp"
            android:visibility="gone"
            app:layout_constraintCircle="@id/dpadCenter"
            app:layout_constraintCircleAngle="270"
            app:layout_constraintCircleRadius="60dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
